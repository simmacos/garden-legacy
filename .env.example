# Web
WEB_UI_PORT=4005

# Sicurezza
# Quanti reverse proxy fidati ci sono davanti all'app (nginx, NPM, Cloudflare, ...): false/0 = nessuno,
# true/1 = uno, 2 = due (es. Cloudflare + NPM). Servono per l'IP reale del client (rate limiting, letto
# da X-Forwarded-For contando da destra) e per capire se la richiesta è HTTPS (X-Forwarded-Proto).
TRUST_PROXY=false
# Flag Secure del cookie di sessione: auto (solo se la richiesta è HTTPS) | true | false.
# "true" su HTTP semplice (non localhost) impedisce il login: il browser scarta il cookie.
COOKIE_SECURE=auto

# Database (allineato a dev-compose/docker-compose.yml)
DB_DIALECT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garden
DB_USER=simmaco
DB_PASSWORD=simmacopass
