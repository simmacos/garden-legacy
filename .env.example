# Web
WEB_UI_PORT=4005

# Sicurezza
# true solo se l'app sta dietro UN reverse proxy fidato (nginx, caddy, ...) che imposta
# X-Forwarded-For / X-Forwarded-Proto: serve per l'IP reale (rate limiting) e per capire se è HTTPS.
TRUST_PROXY=false
# Flag Secure del cookie di sessione: auto (solo se la richiesta è HTTPS) | true | false.
# "true" su HTTP semplice (non localhost) impedisce il login: il browser scarta il cookie.
COOKIE_SECURE=auto

# Database (allineato a dev-compose/docker-compose.yml)
DB_DIALECT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garden
DB_USER=simmaco
DB_PASSWORD=simmacopass
