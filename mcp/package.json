{
  "name": "garden-legacy-mcp",
  "version": "0.0.1",
  "description": "MCP server (stdio) that lets Claude use the Garden Legacy API",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "bin": { "garden-legacy-mcp": "server.mjs" },
  "scripts": {
    "start": "node server.mjs",
    "pack": "npm install --omit=dev && npx -y @anthropic-ai/mcpb@2.1.2 pack . garden-legacy.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
