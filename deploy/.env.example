# Modello del file .env dello stack (in Dockge: editor ".env" accanto al compose).
# Il file VERO esiste solo sul server e non va mai messo nel repository.

# Password lunghe e casuali, per esempio:  openssl rand -base64 24
# ATTENZIONE: MariaDB le legge SOLO al primo avvio (volume vuoto).
# Scegli i valori definitivi PRIMA del primo Deploy: cambiarle qui dopo non le cambia nel database.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# (Opzionale) Porta del server su cui NPM trova l'app. Default: 4005. Cambiala se è già occupata.
# APP_PORT=4005

# (Opzionale) Versione dell'immagine. Default: latest.
# Per tornare a una versione precedente usa il tag con il commit, ad esempio sha-2b193d2
# GARDEN_IMAGE=ghcr.io/simmacos/garden-legacy:latest
